{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=bitionary;Username=postgres;Password=secret"
  },

  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },

  "GithubAuth": {
    "ClientId": "[GITHUB CLIENT ID]",
    "ClientSecret": "[GITHUB CLIENT SECRET]"
  },

  "JwtSettings": {
    "SecretKey": "[JWT SECRET KEY]",
    "ExpiryMinutes": 30,

    "RefreshSecretKey": "[JWT REFRESH SECRET KEY]",
    "RefreshExpiryDays": 7,

    "Issuer": "https://api.bitionary.com",
    "Audience": "https://bitionary.com"
  }
}
